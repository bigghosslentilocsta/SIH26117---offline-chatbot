# MRPL AI Workbench configuration
# Copy to .env and adjust as needed. All values are optional.

# Ollama API endpoint (Docker service name)
OLLAMA_URL=http://ollama:11434/api/generate

# AI model to use
OLLAMA_MODEL=llama3

# Backend port exposed on host
BACKEND_PORT=8000

# Frontend port exposed on host
FRONTEND_PORT=3000

# Ollama port exposed on host
OLLAMA_PORT=11434

# MongoDB connection string (Docker service name or local)
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
MONGO_DB_NAME=mrpl_workbench

# JWT secret key for session tokens (change in production!)
JWT_SECRET=mrpl-airgapped-secret-change-in-prod-2026

# JWT token expiration in minutes
JWT_EXPIRE_MINUTES=480

# ── Default admin account (seeded automatically on first startup) ──
# Username: admin   Password: admin123
# CHANGE THIS IMMEDIATELY after first login via the User Management modal
# (backend/routes/user_routes.py exposes PUT /api/users/password).